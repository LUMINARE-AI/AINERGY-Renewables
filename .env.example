# Local Postgres via `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://powerprocure:powerprocure@localhost:5432/powerprocure"

# `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-generated-secret"

# Powers bill reading on /energy-optimizer (see /api/extract-bill). Get a key from
# https://console.anthropic.com — without it, bill upload shows a clear "not configured"
# message and falls back to manual entry.
ANTHROPIC_API_KEY=""

# Authorizes the scheduled regulatory-data refresh (see vercel.json +
# /api/regulatory/refresh). Vercel automatically sends this as a Bearer token
# on the Cron Job's request when the env var is set — generate with
# `openssl rand -base64 32`, same as AUTH_SECRET. Without it, the refresh
# route is only reachable by a signed-in user's manual trigger.
CRON_SECRET=""
